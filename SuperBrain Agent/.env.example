# --- REQUIRED ---
# Anthropic API key for Vanguard-1 (the "Super Brain").
# Without this the loop cannot run at all.
ANTHROPIC_API_KEY=

# Absolute path to your existing PDF engine entry point.
# factory_bridge.py shells out to:  python "$FACTORY_SCRIPT_PATH" --json '<args>'
FACTORY_SCRIPT_PATH=/absolute/path/to/launch_build.py


# --- RESEARCH SOURCES (each one missing = logged Impediment Report) ---

# GitHub personal access token.  Public search works unauthenticated at 60 req/hr;
# a token lifts that to 5,000 req/hr -> more frequent trend scans -> faster
# gap-finding -> higher strategy throughput.
GITHUB_TOKEN=

# Reddit script-app credentials (https://www.reddit.com/prefs/apps).
# Without these we fall back to the public .json endpoints, which are rate-limited
# and miss gated subs -> narrower pain-point signal.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=vanguard-1/0.1 by u/yourhandle

# X / Twitter v2 bearer token.  Currently OPTIONAL - research_suite.py has no
# X scraper wired up yet; populating this key will let a future sub-agent scan
# virality signals (tweet velocity, reply sentiment) for product validation.
X_BEARER_TOKEN=


# --- OPTIONAL TUNING ---
# Model id.  Default is the latest Opus; override for cost/latency trade-offs.
VANGUARD_MODEL=claude-opus-4-7
# How many Thought->Action->Observation cycles between forced self-reflections.
REFLECTION_INTERVAL=5
# Hard cap on cycles per process run (0 = unlimited; start_vanguard.sh will relaunch).
MAX_CYCLES=0
